[Unit]
Description=Nutri cloud sync (encrypted blobs)
After=network.target

[Service]
User=admin
Environment=PORT=18790
Environment=DATA_DIR=/var/lib/nutri/sync
Environment=CONTRIB_DIR=/var/lib/nutri/contrib
ExecStart=__NODE__ /opt/nutri/sync-server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
